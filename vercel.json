{
  "crons": [
    {
      "path": "/api/cron-class-reminders",
      "schedule": "0 23 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "noted-by-blazed.vercel.app"
        }
      ],
      "destination": "https://classy.exars.my.id/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
